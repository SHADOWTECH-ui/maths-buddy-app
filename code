<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Maths Buddy — Visual Maths Solver</title>
<style>
:root{--bg:#f4f6fb;--card:#fff;--ink:#172033;--muted:#68738a;--accent:#4f46e5;--line:#e1e6f0}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{background:linear-gradient(135deg,#312e81,#6366f1);color:white;padding:28px 18px}
.wrap{max-width:900px;margin:auto;padding:0 16px}header h1{margin:0;font-size:clamp(27px,5vw,40px)}header p{margin:6px 0 0;opacity:.9}
main{padding:22px 0 40px}.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px;margin:0 0 16px;box-shadow:0 5px 18px #1e293b08}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.tab,.example{border:1px solid var(--line);background:#f8f9ff;color:var(--ink);border-radius:12px;padding:10px 14px;cursor:pointer;font-weight:650}.tab.active{background:var(--accent);color:white;border-color:var(--accent)}
label{font-weight:700;display:block;margin-bottom:7px}input,select{width:100%;padding:13px;border:1px solid #cbd3e1;border-radius:12px;font:inherit;background:white;color:#172033}
button.solve{margin-top:14px;width:100%;padding:14px;border:0;border-radius:12px;background:var(--accent);color:white;font:700 16px inherit;cursor:pointer}
.hint,.muted{color:var(--muted);font-size:14px}.examples{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.output{display:grid;gap:12px}.step{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fff}.step small{display:block;color:var(--muted);font-weight:700;margin-bottom:4px}.answer{font-size:25px;font-weight:800;overflow-wrap:anywhere}.diagram{width:100%;max-width:560px;display:block;margin:8px auto}.error{color:#b42318;background:#fff3f2;border:1px solid #ffd4d0;padding:13px;border-radius:12px}
footer{text-align:center;color:var(--muted);padding:0 16px 24px;font-size:13px}
[hidden]{display:none!important}
</style>
</head>
<body>
<header><div class="wrap"><h1>📐 Maths Buddy</h1><p>Your visual maths tutor — understand the steps and see the figure.</p></div></header>
<main class="wrap">
<section class="card">
<div class="tabs">
<button class="tab active" data-mode="equation">Equations</button>
<button class="tab" data-mode="calculation">Calculation</button>
<button class="tab" data-mode="geometry">Geometry</button>
<button class="tab" data-mode="coordinate">Coordinate graph</button>
</div>
<div id="equationPane">
<label for="equation">Enter equation</label>
<input id="equation" value="2x + 5 = 15" placeholder="e.g. x^2 - 5x + 6 = 0">
<div class="examples">
<button class="example" data-fill="equation" data-value="2x + 5 = 15">Linear</button>
<button class="example" data-fill="equation" data-value="x^2 - 5x + 6 = 0">Quadratic</button>
<button class="example" data-fill="equation" data-value="3(x + 2) = 21">Brackets</button>
</div>
</div>
<div id="calculationPane" hidden>
<label for="calculation">Enter calculation</label>
<input id="calculation" value="(12 + 8) * 3" placeholder="e.g. (12 + 8) * 3">
<p class="hint">Use +, -, *, /, ^ and brackets. Example: 2^3 + 4.</p>
</div>
<div id="geometryPane" hidden>
<label for="shape">Choose a figure</label>
<select id="shape">
<option value="triangle">Right-angled triangle</option>
<option value="rectangle">Rectangle</option>
<option value="circle">Circle</option>
<option value="pythagoras">Pythagoras theorem</option>
</select>
<div id="geometryInputs" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-top:12px"></div>
</div>
<div id="coordinatePane" hidden>
<label for="graphEquation">Graph equation</label>
<input id="graphEquation" value="y = 2x + 1" placeholder="e.g. y = x^2 - 4">
<p class="hint">Graphs supported: y = mx + b or y = ax^2 + bx + c.</p>
</div>
<button class="solve" id="solve">Solve and show diagram</button>
</section>
<section class="card"><h2 style="margin-top:0">Solution & diagram</h2><div id="output" class="output"><p class="muted">Enter a question and tap “Solve and show diagram”.</p></div></section>
</main>
<footer>Maths Buddy • Learning tool • Always check your working</footer>
<script>
const $=id=>document.getElementById(id);
let mode='equation';
const fields={
 triangle:[['base','Base','8'],['height','Height','6']],
 rectangle:[['length','Length','10'],['width','Width','5']],
 circle:[['radius','Radius','7']],
 pythagoras:[['a','Side a','3'],['b','Side b','4']]
};
function setMode(m){
 mode=m;
 document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.mode===m));
 ['equation','calculation','geometry','coordinate'].forEach(p=>$(p+'Pane').hidden=p!==m);
}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.mode)));
document.querySelectorAll('.example').forEach(b=>b.addEventListener('click',()=>$(b.dataset.fill).value=b.dataset.value));
function buildGeometryInputs(){
 const shape=$('shape').value; $('geometryInputs').innerHTML='';
 fields[shape].forEach(([id,label,value])=>{
  const box=document.createElement('div');box.innerHTML='<label for="'+id+'">'+label+'</label><input id="'+id+'" type="number" min="0.01" step="any" value="'+value+'">';
  $('geometryInputs').appendChild(box);
 });
}
$('shape').addEventListener('change',buildGeometryInputs);buildGeometryInputs();
const fmt=n=>Number(n.toFixed(6)).toString();
function show(answer,steps,svg=''){
 $('output').innerHTML='<div class="step"><small>FINAL ANSWER</small><div class="answer">'+answer+'</div></div>'+
 steps.map((s,i)=>'<div class="step"><small>STEP '+(i+1)+'</small>'+s+'</div>').join('')+
 (svg?'<div class="step"><strong>Diagram</strong>'+svg+'</div>':'');
}
function error(msg){$('output').innerHTML='<div class="error">'+msg+'</div>'}
function makeSVG(inner,label='Maths diagram'){
 return '<svg class="diagram" viewBox="0 0 360 220" role="img" aria-label="'+label+'" xmlns="http://www.w3.org/2000/svg">'+
 '<rect x="1" y="1" width="358" height="218" rx="12" fill="#fbfcff" stroke="#e1e6f0"/>'+inner+'</svg>';
}
function solveGeometry(){
 const shape=$('shape').value,read=id=>Number($(id).value);
 if(shape==='triangle'||shape==='pythagoras'){
  let a=read(shape==='triangle'?'base':'a'),b=read(shape==='triangle'?'height':'b');
  if(!(a>0&&b>0))throw Error('Please enter positive measurements.');
  let c=Math.hypot(a,b),area=a*b/2;
  const svg=makeSVG('<path d="M55 175 L305 175 L55 40 Z" fill="#4f46e51a" stroke="#4f46e5" stroke-width="3"/><path d="M55 155h20v20" fill="none" stroke="#172033" stroke-width="2"/><text x="180" y="198" text-anchor="middle" font-size="15" fill="#172033">Base = '+fmt(a)+'</text><text x="28" y="110" text-anchor="middle" font-size="14" fill="#172033" transform="rotate(-90 28 110)">Height = '+fmt(b)+'</text><text x="180" y="96" font-size="15" fill="#172033">c = '+fmt(c)+'</text>','Right triangle with base, height and hypotenuse');
  show('Hypotenuse = '+fmt(c)+(shape==='triangle'?' • Area = '+fmt(area):''),[
   'Pythagoras theorem: c² = a² + b².',
   'Substitute: c² = '+fmt(a)+'² + '+fmt(b)+'² = '+fmt(a*a+b*b)+'.',
   'Take square root: c = √'+fmt(a*a+b*b)+' = '+fmt(c)+'.',
   ...(shape==='triangle'?['Triangle area = ½ × base × height = ½ × '+fmt(a)+' × '+fmt(b)+' = '+fmt(area)+'.']:[])
  ],svg);
 } else if(shape==='rectangle'){
  let l=read('length'),w=read('width');if(!(l>0&&w>0))throw Error('Enter positive length and width.');
  let A=l*w,P=2*(l+w);
  let svg=makeSVG('<rect x="65" y="55" width="230" height="110" rx="2" fill="#4f46e51a" stroke="#4f46e5" stroke-width="3"/><text x="180" y="190" text-anchor="middle" font-size="15" fill="#172033">Length = '+fmt(l)+'</text><text x="35" y="112" text-anchor="middle" font-size="14" fill="#172033" transform="rotate(-90 35 112)">Width = '+fmt(w)+'</text>');
  show('Area = '+fmt(A)+' • Perimeter = '+fmt(P),['Area = length × width = '+fmt(l)+' × '+fmt(w)+' = '+fmt(A)+'.','Perimeter = 2(length + width) = 2('+fmt(l)+' + '+fmt(w)+') = '+fmt(P)+'.'],svg);
 } else {
  let r=read('radius');if(!(r>0))throw Error('Enter a positive radius.');
  let A=Math.PI*r*r,C=2*Math.PI*r;
  let svg=makeSVG('<circle cx="180" cy="110" r="72" fill="#4f46e51a" stroke="#4f46e5" stroke-width="3"/><path d="M180 110H252" stroke="#e11d48" stroke-width="3"/><circle cx="180" cy="110" r="4" fill="#172033"/><text x="211" y="99" font-size="15" fill="#172033">r = '+fmt(r)+'</text><text x="180" y="205" text-anchor="middle" font-size="14" fill="#172033">Circle</text>');
  show('Area = '+fmt(A)+' • Circumference = '+fmt(C),['Area = πr² = π × '+fmt(r)+'² ≈ '+fmt(A)+'.','Circumference = 2πr = 2π × '+fmt(r)+' ≈ '+fmt(C)+'.'],svg);
 }
}
function tokenize(s){
 const tokens=s.match(/\d+(?:\.\d+)?|[()+\-*/^]/g)||[];
 if(tokens.join('')!==s.replace(/\s/g,''))throw Error('Expression contains unsupported characters.');
 return tokens;
}
function calculate(s){
 let t=tokenize(s),i=0;
 function atom(){let x=t[i++];if(x==='('){let v=expr();if(t[i++]!==')')throw Error('Check brackets.');return v;}if(x==='-')return -atom();if(x==='+')return atom();let n=Number(x);if(!Number.isFinite(n))throw Error('Expected a number.');return n;}
 function power(){let a=atom();if(t[i]==='^'){i++;a=Math.pow(a,power());}return a;}
 function term(){let a=power();while(t[i]==='*'||t[i]==='/'){let op=t[i++],b=power();if(op==='/'&&b===0)throw Error('Cannot divide by zero.');a=op==='*'?a*b:a/b;}return a;}
 function expr(){let a=term();while(t[i]==='+'||t[i]==='-'){let op=t[i++],b=term();a=op==='+'?a+b:a-b;}return a;}
 let result=expr();if(i!==t.length||!Number.isFinite(result))throw Error('Check the expression.');return result;
}
function solveCalc(){
 let raw=$('calculation').value.replace(/×/g,'*').replace(/÷/g,'/');
 let ans=calculate(raw);
 show('= '+fmt(ans),['Use the order of operations: brackets, powers, multiplication/division, addition/subtraction.','Evaluate the expression carefully: '+raw+' = '+fmt(ans)+'.']);
}
function parseEquation(raw){
 let s=raw.replace(/\s/g,'').replace(/−/g,'-').replace(/²/g,'^2');
 if(!s.includes('='))throw Error('Enter an equation containing =.');
 let [left,right,...rest]=s.split('=');if(rest.length)throw Error('Enter one equation.');
 function poly(str){
  let tokens=str.match(/[+-]?[^+-]+/g)||[],p=[0,0,0];
  tokens.forEach(tok=>{
   let sign=1;if(tok[0]==='+')tok=tok.slice(1);else if(tok[0]==='-'){sign=-1;tok=tok.slice(1);}
   let m=tok.match(/^(\d*\.?\d*)?x(?:\^([12]))?$/i);
   if(m){let coeff=m[1]===''||m[1]===undefined?1:Number(m[1]);let pow=Number(m[2]||1);p[pow]+=sign*coeff;}
   else if(tok.includes('x'))throw Error('Use x or x^2 with a numeric coefficient, e.g. 3x+2=8.');
   else p[0]+=sign*Number(tok);
  });return p;
 }
 let a=poly(left),b=poly(right);return a.map((v,i)=>v-b[i]);
}
function solveEquation(){
 let [c,b,a]=parseEquation($('equation').value),steps=[];
 if(Math.abs(a)<1e-10){
  if(Math.abs(b)<1e-10)throw Error(Math.abs(c)<1e-10?'Both sides are identical.':'No solution.');
  let x=-c/b;show('x = '+fmt(x),['Move constants to one side: '+fmt(b)+'x = '+fmt(-c)+'.','Divide both sides by '+fmt(b)+'.','x = '+fmt(-c)+' ÷ '+fmt(b)+' = '+fmt(x)+'.']);return;
 }
 let d=b*b-4*a*c;
 if(d<0){show('No real roots',['Discriminant D = b² − 4ac = '+fmt(d)+'.','Since D is negative, the graph does not cross the x-axis.'],parabola(a,b,c,[]));return;}
 let r1=(-b+Math.sqrt(d))/(2*a),r2=(-b-Math.sqrt(d))/(2*a);
 show('x = '+fmt(r1)+(Math.abs(r1-r2)>1e-8?' or '+fmt(r2):''),['Identify a = '+fmt(a)+', b = '+fmt(b)+', c = '+fmt(c)+'.','Discriminant D = b² − 4ac = '+fmt(d)+'.','Quadratic formula: x = (−b ± √D) / 2a.','Substitute and simplify to get the roots.'],parabola(a,b,c,[r1,r2]));
}
function parabola(a,b,c,roots){
 let W=340,H=190,xmin=-6,xmax=6,ymin=-10,ymax=20;
 const X=x=>(x-xmin)/(xmax-xmin)*W,Y=y=>H-(y-ymin)/(ymax-ymin)*H;
 let pts=[];for(let i=0;i<=150;i++){let x=xmin+(xmax-xmin)*i/150,y=a*x*x+b*x+c;pts.push((i?'L':'M')+X(x)+','+Y(Math.max(ymin,Math.min(ymax,y))))}
 let path=pts.join(' ');
 let marks=roots.map(r=>'<circle cx="'+X(r)+'" cy="'+Y(0)+'" r="5" fill="#e11d48"/><text x="'+X(r)+'" y="'+(Y(0)-10)+'" text-anchor="middle" font-size="12" fill="#172033">'+fmt(r)+'</text>').join('');
 return makeSVG('<path d="M'+X(0)+' 10V'+H+' M0 '+Y(0)+'H'+W+'" stroke="#94a3b8"/><path d="'+path+'" fill="none" stroke="#4f46e5" stroke-width="3"/>'+marks,'Parabola graph with roots');
}
function solveCoordinate(){
 let s=$('graphEquation').value.replace(/\s/g,'').replace('−','-');
 let m=s.match(/^y=([+-]?\d*\.?\d*)x(?:\^2)?([+-]\d*\.?\d*x)?([+-]\d*\.?\d+)?$/i);
 if(!m){
  // Simple linear y=mx+b fallback
  let q=s.match(/^y=([+-]?\d*\.?\d*)x([+-]\d*\.?\d+)?$/i);
  if(!q)throw Error('Try y = 2x + 1 or y = x^2 - 4.');
  let a=q[1]===''||q[1]==='+'?1:q[1]==='-'?-1:Number(q[1]),b=Number(q[2]||0);
  let svg=makeSVG('<path d="M25 110H335 M180 15V195" stroke="#94a3b8"/><path d="M35 '+(110-b*12)+'L325 '+(110-(a*12+b)*12)+'" stroke="#4f46e5" stroke-width="3"/>');
  show('Graph of y = '+a+'x + '+b,['Choose x-values and calculate y = '+a+'x + '+b+'.','Plot the points and join them with a straight line.'],svg);return;
 }
 throw Error('For the graph tool, use a simple linear equation y=mx+b. Quadratic graph drawing is available when solving x² equations.');
}
$('solve').addEventListener('click',()=>{
 try{if(mode==='equation')solveEquation();else if(mode==='calculation')solveCalc();else if(mode==='geometry')solveGeometry();else solveCoordinate();}
 catch(e){error(e.message||'Please check your question.');}
});
</script>
</body>
</html>